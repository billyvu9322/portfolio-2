{
  "name": "binhvu-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "profile:sync": "node scripts/sync-profile.mjs",
    "dev": "npm run profile:sync && next dev -p 8900",
    "build": "npm run profile:sync && next build",
    "start": "next start -p 8900",
    "lint": "next lint",
    "deploy": "npm run build && npx wrangler pages deploy build --project-name=porfolio --branch=main --commit-dirty=true",
    "worker:dev": "npx wrangler@4.34.0 dev",
    "worker:deploy": "npx wrangler@4.34.0 deploy",
    "wrangler:deploy": "npx wrangler@4.34.0 deploy",
    "worker:typecheck": "tsc -p worker/tsconfig.json --noEmit",
    "worker:types": "npx wrangler@4.34.0 types"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.16",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.1.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.13",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^13.1.0",
    "gsap": "^3.13.0",
    "howler": "^2.2.4",
    "lenis": "^1.1.20",
    "lucide-react": "^0.469.0",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.172.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/three": "^0.172.0",
    "typescript": "^5"
  }
}
